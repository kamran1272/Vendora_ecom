{
  "name": "@vendora/api",
  "private": true,
  "version": "1.0.0",
  "description": "Vendora API - NestJS Backend",
  "type": "commonjs",
  "scripts": {
    "predev": "prisma generate --schema prisma/schema.prisma",
    "dev": "nest start --watch",
    "prebuild": "prisma generate --schema prisma/schema.prisma",
    "build": "nest build && echo 'Build complete'",
    "prestart": "prisma generate --schema prisma/schema.prisma",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint . --ext .ts",
    "migration:create": "typeorm migration:create -d src/database/config/typeorm-config.ts",
    "migration:run": "typeorm migration:run -d src/database/config/typeorm-config.ts",
    "migration:show": "typeorm migration:show -d src/database/config/typeorm-config.ts",
    "migration:revert": "typeorm migration:revert -d src/database/config/typeorm-config.ts",
    "seed:run": "tsx src/database/seeds/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.2.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.2.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^10.0.1",
    "@nestjs/platform-express": "^10.2.0",
    "@nestjs/platform-socket.io": "^10.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^10.2.0",
    "@prisma/client": "5.20.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "prisma": "5.20.0",
    "redis": "4.6.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "4.8.1",
    "sqlite3": "^6.0.1",
    "stripe": "17.1.0",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.2",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.10.0",
    "@types/passport-jwt": "^3.0.10",
    "@types/redis": "4.0.11",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
