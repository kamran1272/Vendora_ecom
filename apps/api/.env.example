# API runtime configuration
NODE_ENV=development
PORT=4003
PUBLIC_WEB_URL=http://localhost:4173

# Payment providers. A method is offered only when its required credentials are configured.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
BINANCE_PAY_API_KEY=your_binance_pay_api_key
BINANCE_PAY_SECRET_KEY=your_binance_pay_secret_key
BTCPAY_API_URL=https://your-btcpay-server.example.com
BTCPAY_API_KEY=your_btcpay_api_key

# Prisma / PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vendora?schema=public"
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=vendora
SQLITE_PATH=./data/dev.sqlite

# App secrets
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-secure-one-time-password
SEED_USER_PASSWORD=replace-with-a-secure-development-fixture-password
WEB_APP_URL=http://localhost:4173
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
TWO_FACTOR_ISSUER=Vendora
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=replace-with-mail-user
MAIL_PASSWORD=replace-with-mail-password
MAIL_FROM=noreply@example.com

# Security
THROTTLE_TTL=60
THROTTLE_LIMIT=120
